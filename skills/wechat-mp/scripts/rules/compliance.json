{
  "version": "1.0",
  "disclaimer": "本规则集是发布前提示，不是过审保证。命中不等于违规，需结合语境人工判断。",
  "categories": [
    {
      "id": "absolute",
      "label": "广告法·绝对化用语",
      "severity": "medium",
      "terms": [
        "最好", "最佳", "最强", "最优", "最先进", "最便宜", "最专业", "最权威",
        "最领先", "最顶级", "最高端", "最豪华", "最有效", "最安全",
        "第一品牌", "行业第一", "销量第一", "全国第一", "全球第一", "排名第一",
        "唯一", "首个", "首创", "独家", "顶尖", "顶级", "极致", "王牌",
        "国家级", "世界级", "全球领先", "国际领先", "史上最", "全网最",
        "天花板", "前无古人", "史无前例", "不可替代", "绝对领先"
      ],
      "suggest": "改为可验证的相对表述，例如「在同价位中表现较好」「目前测得的 X 为 Y」。"
    },
    {
      "id": "guarantee",
      "label": "虚假承诺 / 保证性表述",
      "severity": "high",
      "terms": [
        "保证", "承诺", "确保", "百分百", "100%有效", "百分之百",
        "绝对有效", "一定成功", "必然", "零风险", "无风险", "稳赚", "稳赢",
        "保本", "保收益", "包过", "包就业", "包分配", "立竿见影", "立刻见效",
        "一次通过", "包治", "根治", "治愈", "药到病除", "永久有效", "终身有效"
      ],
      "suggest": "删掉承诺语气，改成过程描述或限定条件下的结果，并注明数据来源。"
    },
    {
      "id": "induce",
      "label": "诱导关注 / 分享 / 点赞",
      "severity": "high",
      "patterns": [
        "关注(?:我|本号|公众号|公众号后台).{0,12}(?:领|取|送|抽|回复|获取|免费)",
        "(?:转发|分享|点赞|点在看|评论).{0,12}(?:抽|领|送|得|奖|红包)",
        "(?:关注|转发|分享)(?:即可|就能|马上).{0,10}(?:领|送|得)",
        "集赞",
        "拉新.{0,6}(?:奖励|返现|红包)",
        "扫码.{0,12}(?:领|送|得|抽)",
        "免费领(?:取)?",
        "(?:不转|不分享).{0,10}(?:不是|就不)"
      ],
      "suggest": "改为不涉及利益交换的引导，例如「如果对你有帮助，点个『在看』让更多人看到」。"
    },
    {
      "id": "industry_medical",
      "label": "医疗健康类表述限制",
      "severity": "high",
      "terms": ["特效", "特效药", "偏方", "秘方", "祖传", "神药", "根治", "包治", "无副作用", "彻底治愈"],
      "suggest": "医疗健康内容需资质与证据支撑，避免疗效断言；建议改为科普表述并注明来源。"
    },
    {
      "id": "industry_finance",
      "label": "金融理财类表述限制",
      "severity": "high",
      "terms": ["年化收益", "保本保息", "稳赚不赔", "翻倍", "暴富", "躺赚", "内幕消息", "必涨", "荐股"],
      "suggest": "金融内容不得承诺收益，需风险提示；无相关资质不建议涉及具体标的推荐。"
    },
    {
      "id": "industry_edu",
      "label": "教育培训/招聘类表述限制",
      "severity": "high",
      "terms": ["保过", "包过", "内部指标", "包就业", "保offer", "内推保过", "百分百就业"],
      "suggest": "教育培训与招聘内容不得承诺结果，避免具体通过率/就业率断言。"
    },
    {
      "id": "ai_flavor",
      "label": "AI 味套话",
      "severity": "low",
      "terms": [
        "综上所述", "总而言之", "总的来说", "众所周知", "值得注意的是",
        "不难发现", "在当今", "随着.{0,8}的(?:发展|普及|到来)", "在这个.{0,6}的时代",
        "首先", "其次", "再者", "最后一点", "需要指出的是", "我们可以看出",
        "赋能", "抓手", "闭环", "颗粒度", "底层逻辑", "打法", "心智",
        "让我们", "接下来我们", "下面我们"
      ],
      "suggest": "删掉不影响信息量的过渡词。判断标准：删掉后读者理解是否受影响，不受影响就删。"
    },
    {
      "id": "sensitive_review",
      "label": "需人工复核的高风险题材",
      "severity": "medium",
      "terms": ["政治", "游行", "集会", "宗教", "民族", "疫苗", "涉密", "内部文件", "未公开"],
      "suggest": "涉及政治、民族宗教、公共安全、涉密信息的内容请人工完整复核，agent 不放行此类内容。"
    }
  ],
  "exclude_from_scan": [
    "最后", "最初", "最近", "最终", "最先", "最高兴", "最低谷"
  ],
  "link_allow_hosts": [
    "mp.weixin.qq.com",
    "weixin.qq.com",
    "mmbiz.qpic.cn",
    "mmbiz.qlogo.cn",
    "res.wx.qq.com"
  ],
  "image_allow_hosts": [
    "mmbiz.qpic.cn",
    "mmbiz.qlogo.cn",
    "res.wx.qq.com"
  ],
  "limits": {
    "title_max_chars": 64,
    "title_feed_display": 20,
    "summary_max_chars": 120,
    "paragraph_max_chars": 260,
    "reading_chars_per_minute": 400
  }
}
