{
  "name": "minimal",
  "label": "极简黑白 · 观点/评论向",
  "extends": "tech",
  "showCodeLang": false,
  "hrGlyph": "— — —",
  "colors": {
    "accent": "#111111",
    "accentSoft": "#f4f4f4",
    "note": "#444444",
    "noteSoft": "#f7f7f7",
    "tip": "#333333",
    "tipSoft": "#f5f5f5",
    "warning": "#666666",
    "warningSoft": "#f7f7f7",
    "important": "#222222",
    "importantSoft": "#f7f7f7"
  },
  "page": {
    "backgroundColor": "#ffffff"
  },
  "wrapper": {
    "backgroundColor": "#ffffff"
  },
  "styles": {
    "body": {
      "fontSize": "16px",
      "lineHeight": "1.95",
      "letterSpacing": "0.6px",
      "color": "#1a1a1a"
    },
    "p": {
      "margin": "0 0 1.7em 0",
      "lineHeight": "1.95",
      "color": "#1a1a1a"
    },
    "h1": {
      "fontSize": "21px",
      "color": "#000000",
      "letterSpacing": "0.5px"
    },
    "h2": {
      "decoration": "underline",
      "fontSize": "17.5px",
      "color": "#000000",
      "margin": "2.2em 0 1em 0",
      "paddingBottom": "6px",
      "letterSpacing": "0.5px"
    },
    "h3": {
      "fontSize": "16px",
      "color": "#000000",
      "fontWeight": "700"
    },
    "strong": {
      "color": "#000000",
      "fontWeight": "700",
      "textDecoration": "underline",
      "textDecorationThickness": "2px"
    },
    "em": {
      "fontStyle": "italic",
      "color": "#444444"
    },
    "mark": {
      "backgroundColor": "#eaeaea",
      "padding": "0 2px"
    },
    "code": {
      "backgroundColor": "#f2f2f2",
      "color": "#111111",
      "padding": "2px 5px"
    },
    "codeBlock": {
      "backgroundColor": "#f7f7f7",
      "borderLeft": "3px solid #d4d4d4",
      "borderRadius": "0"
    },
    "preCode": {
      "color": "#222222"
    },
    "codeLang": {
      "color": "#888888"
    },
    "quote": {
      "borderLeft": "3px solid #d4d4d4",
      "backgroundColor": "#fafafa",
      "padding": "12px 16px",
      "borderRadius": "0"
    },
    "quoteP": {
      "color": "#555555"
    },
    "bullet": {
      "color": "#111111"
    },
    "olNumber": {
      "color": "#111111"
    },
    "th": {
      "backgroundColor": "#f4f4f4",
      "border": "1px solid #e0e0e0"
    },
    "td": {
      "border": "1px solid #e0e0e0"
    },
    "img": {
      "borderRadius": "0"
    },
    "link": {
      "color": "#111111",
      "borderBottom": "1px solid #111111"
    }
  }
}
